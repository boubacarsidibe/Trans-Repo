# Config de developpement pour docker-compose.yml. Copier en .env a la
# racine du depot (jamais commite : voir .gitignore).

POSTGRES_DB=Transdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword

# openssl rand -hex 64, par exemple. La valeur par defaut dans
# application.properties suffit en dev local, mais pas au-dela.
JWT_SECRET=changez-moi-en-dev
