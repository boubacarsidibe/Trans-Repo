# Variables lues par docker-compose.yml (pas par les applications elles-memes,
# qui ont leurs propres .env.example dans backend_trans/, frontend/ et
# agent/*/). Copier en .env a la racine pour surcharger les defauts.

POSTGRES_DB=Transdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword

# Port hote sur lequel le frontend (nginx) est publie.
FRONTEND_PORT=8081
