BACKEND_URL=http://localhost:8080
EQUIPMENT_ID=00000000-0000-0000-0000-000000000000
API_KEY=change-me
INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# --- Sondes optionnelles : chaque bloc reste desactive tant que sa/ses
# variable(s) ne sont pas renseignees (ou, pour les 3 sondes ci-dessous, tant
# que son propre PROBE_xxx n'est pas mis a true). ---

# Charge machine (load average / nombre de coeurs) et limites de ressources
# (fichiers ouverts, processus) : aucune configuration a part l'activation,
# desactivees par defaut.
PROBE_CHARGE_MACHINE=false
PROBE_LIMITES_RESSOURCES=false

# Temperature et vitesse de ventilateur, via les capteurs materiels exposes
# par psutil (absents sur beaucoup de VM/conteneurs, d'ou l'activation
# explicite plutot qu'une detection automatique silencieuse).
PROBE_CAPTEURS=false

# Verifie que ces services TCP locaux repondent (host:port, ou juste "port"
# pour localhost). Ex : TCP_HEALTHCHECK_PORTS=5432,localhost:8080,10.0.0.5:22
TCP_HEALTHCHECK_PORTS=
TCP_CHECK_TIMEOUT_SECONDS=2

# Mesure le temps de resolution DNS d'un nom donne.
DNS_CHECK_HOSTNAME=
DNS_CHECK_TIMEOUT_SECONDS=2

# Compte les nouvelles lignes (et celles matchant LOG_PATTERN, regex Python)
# ecrites dans ce fichier depuis le dernier cycle. Gere la rotation/troncature.
LOG_FILE_PATH=
LOG_PATTERN=
STATE_FILE_PATH=agent_state.json

# Verifie l'existence et la taille d'un fichier donne.
WATCHED_FILE_PATH=

# Lecture Modbus TCP optionnelle - NON VERIFIEE contre un vrai automate/PLC
# (aucun equipement disponible pour tester). A valider avant toute mise en
# production sur un site avec des equipements industriels reels.
MODBUS_HOST=
MODBUS_PORT=502
MODBUS_UNIT_ID=1
MODBUS_REGISTER_ADDRESS=0
MODBUS_REGISTER_TYPE=holding
