BACKEND_URL=http://localhost:8080
EQUIPMENTS_CONFIG_PATH=./equipments.json
INTERVAL_SECONDS=60
PING_TIMEOUT_SECONDS=2
SNMP_TIMEOUT_SECONDS=3
REQUEST_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# Redondance (facultatif, cf. README.md § Redondance) : deux instances, une
# seule active a la fois. Laisser COLLECTOR_ROLE=unique pour une instance
# seule (comportement historique).
# COLLECTOR_ID=collecteur-primaire
# COLLECTOR_ROLE=unique
# COLLECTOR_API_KEY=
# HEARTBEAT_PORT=8091
# PEER_HEARTBEAT_URL=
# FAILOVER_CYCLES_TOLERES=3
# PEER_CHECK_TIMEOUT_SECONDS=3

# Recepteur de traps SNMP (v1/v2c), en plus du polling ci-dessus. Actif
# uniquement sur l'instance active (primaire, ou secondaire ayant bascule) :
# une instance en veille ne doit pas reagir aux traps.
# SNMP_TRAP_PORT=1162 par defaut (port non privilegie) : le port standard 162
# exige des droits root / cap_net_bind_service, voir README.md.
SNMP_TRAP_ENABLED=true
SNMP_TRAP_BIND_ADDRESS=0.0.0.0
SNMP_TRAP_PORT=1162
SNMP_TRAP_COMMUNITY=public
