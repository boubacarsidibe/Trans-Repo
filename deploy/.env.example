# Config du serveur CRI pour docker-compose.prod.yml. Copier en .env A LA
# RACINE DU DEPOT sur le serveur (jamais dans Git : ce fichier ne contient
# que des defauts d'exemple, le vrai .env porte de vrais secrets).

GHCR_OWNER=boubacarsidibe
IMAGE_TAG=latest

POSTGRES_DB=Transdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-moi

# openssl rand -hex 64, par exemple - jamais la valeur par defaut de
# application.properties en production.
JWT_SECRET=change-moi

# Origine(s) exactement comme le navigateur y accede (schema+hote+port).
CORS_ALLOWED_ORIGINS=http://cri-hostname

# Notifications e-mail (F7) - laisser SMTP_HOST vide desactive l'envoi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Port publie sur le serveur CRI (le reverse proxy nginx).
HTTP_PORT=80
